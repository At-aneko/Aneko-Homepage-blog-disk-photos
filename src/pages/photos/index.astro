---
import PhotoGallery from '../../components/PhotoGallery.vue'
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro'

export const prerender = false
---

<WorkspaceLayout
  title="相册 - Aneko"
  description="从相册取回光影与片刻"
  product="photos"
>
  <PhotoGallery client:load />
</WorkspaceLayout>

<style is:global>
  /* 相册页显示页面滚动条（全站默认隐藏）；显式清掉轨道底色和箭头按钮，避免旧内核露出白条 */
  html {
    scrollbar-width: thin;
    scrollbar-color: rgba(37, 42, 50, 0.42) transparent;
  }

  html::-webkit-scrollbar {
    width: 9px;
    background: transparent;
  }

  html::-webkit-scrollbar-track {
    background: transparent;
  }

  html::-webkit-scrollbar-thumb {
    border-radius: 5px;
    background: rgba(37, 42, 50, 0.42);
  }

  html::-webkit-scrollbar-thumb:hover {
    background: rgba(37, 42, 50, 0.6);
  }

  html::-webkit-scrollbar-button {
    display: none;
    width: 0;
    height: 0;
  }

  html::-webkit-scrollbar-corner {
    background: transparent;
  }

  html[data-theme='Dark'] {
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  html[data-theme='Dark']::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
  }

  html[data-theme='Dark']::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.45);
  }
</style>
